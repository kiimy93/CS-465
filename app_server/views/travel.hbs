		<div id="contents">
			<div class="box">
				<div>
					<div id="travel" class="body">
						<h1>Travel</h1>

						{{#each trips}}
						<div style="display: flex; align-items: flex-start; margin-bottom: 30px;">
							
							<div style="margin-right: 20px;">
								<h2>{{this.name}}</h2>
								<p>
									{{this.description}}
								</p>
							</div>

							<img src="/images/{{this.image}}" alt="{{this.name}}" style="width: 300px;">

						</div>
						<hr>
						{{/each}}

					</div>
				</div>
			</div>
